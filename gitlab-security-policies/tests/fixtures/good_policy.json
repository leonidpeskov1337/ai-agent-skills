{
 "scan_execution_policy": [
   {
     "name": "SAST",
     "description": "Centrally enforced SAST.",
     "enabled": true,
     "skip_ci": {"allowed": false},
     "no_pipeline": {"allowed": false},
     "rules": [
       {"type": "pipeline", "branch_type": "all", "pipeline_sources": {"including": ["merge_request_event"]}},
       {"type": "pipeline", "branch_type": "default", "pipeline_sources": {"including": ["push"]}}
     ],
     "actions": [
       {
         "scan": "sast",
         "template": "latest",
         "tags": ["scanners"],
         "variables": {"AST_ENABLE_MR_PIPELINES": "true"},
         "scan_settings": {"ignore_default_before_after_script": true}
       }
     ],
     "policy_scope": {"projects": {"excluding": [{"id": 42}]}}
   }
 ],
 "approval_policy": [
   {
     "name": "Block new critical SAST",
     "enabled": true,
     "enforcement_type": "enforce",
     "fallback_behavior": {"fail": "closed"},
     "rules": [
       {"type": "scan_finding", "branch_type": "protected", "scanners": ["sast"],
        "severity_levels": ["critical"], "vulnerability_states": ["new_needs_triage"], "vulnerabilities_allowed": 0}
     ],
     "actions": [{"type": "require_approval", "approvals_required": 1, "group_approvers_ids": [7]}],
     "approval_settings": {
       "prevent_approval_by_author": true,
       "prevent_approval_by_commit_author": true,
       "remove_approvals_with_new_commit": true,
       "block_branch_modification": true,
       "prevent_pushing_and_force_pushing": true,
       "prevent_editing_approval_rules": true
     },
     "policy_scope": {"projects": {"excluding": [{"id": 42}]}}
   }
 ]
}
