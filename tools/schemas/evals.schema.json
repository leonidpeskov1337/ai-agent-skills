{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["skill_name", "evals"],
  "properties": {
    "skill_name": {"type": "string", "minLength": 1},
    "fixture_file": {"type": "string", "minLength": 1},
    "evals": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "assertions"],
        "properties": {
          "id": {"type": ["integer", "string"]},
          "prompt": {"type": "string", "minLength": 1},
          "expected_output": {"type": "string", "minLength": 1},
          "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "assertions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "if": {"not": {"required": ["fixture_file"]}},
  "then": {"properties": {"evals": {"items": {"required": ["prompt", "expected_output"]}}}}
}
